# Copy to .env and fill in real values. .env is gitignored and must never be committed.
#
# B2C auth is simpler than the B2B project's: Signature only needs MerchantID + ApiKey
# (no Password/AgentCode/BrowserKey/agent login) — see the Postman collection's
# "Generate Signature" request.

# --- which credential set is active on boot ---
API_ENV=beta
ENV=dev
DEBUG=false

# --- where the UI listens ---
PORT=3002
HOST=0.0.0.0

# Browser origins allowed to call the API. The bundled UI is same-origin and needs
# none of these by default.
# CORS_ORIGIN=https://some-other-tool.internal

# --- identifies this tool's traffic to the network/API team, on every live request ---
# CLIENT_APP_HEADER_NAME=X-Client-App
# CLIENT_APP_HEADER_VALUE=api-automation-b2c

# --- beta endpoints (three separate subdomains — see the Postman collection) ---
UtilsURLTest=https://b2cbetautilsapi.akbartravels.com
FlightURLTest=https://b2cbetaapi.akbartravels.com
AvlURLTest=https://b2cbetaavlapi.akbartravels.com
BASE_URL=https://b2cbetaapi.akbartravels.com

# --- beta credentials (from the shared B2C Postman Beta environment) ---
MerchantID=
ApiKey=

# --- live endpoints and credentials (not needed until a production readiness pass) ---
LIVE_UtilsURLTest=
LIVE_FlightURLTest=
LIVE_AvlURLTest=
LIVE_BASE_URL=
LIVE_MerchantID=
LIVE_ApiKey=

# --- default search inputs ---
ADT=1
CHD=0
INF=0
TripType=ONE
CONCURRENCY=3

# --- guest traveller/contact test data, for CreateItinerary (see td_* vars in the Postman env) ---
TD_CONTACT_MOBILE=9526835735
TD_CONTACT_EMAIL=test.guest@example.com
TD_CONTACT_ADDRESS=Akbar Online Booking Company Pvt Ltd
TD_CONTACT_COUNTRY_CODE=IN
TD_CONTACT_MOBILE_COUNTRY_CODE=+91
TD_CONTACT_STATE=Maharashtra
TD_CONTACT_CITY=Mumbai
TD_CONTACT_PIN=400003
TD_TRAVELLER_TITLE=Mr
TD_TRAVELLER_FIRST_NAME=TEST
TD_TRAVELLER_LAST_NAME=TEST
TD_TRAVELLER_GENDER=M
TD_TRAVELLER_PTC=ADT
TD_TRAVELLER_NATIONALITY=IN
