{
  "name": "api-automation-b2c",
  "version": "0.1.0",
  "description": "Live, scenario-driven test automation for the B2C airline booking API — bootstrapped from api-automation-node's engine.",
  "main": "index.js",
  "scripts": {
    "test:scenarios": "jest tests/scenarios.test.js --testTimeout=90000",
    "test:scenarios:live": "cross-env API_ENV=live jest tests/scenarios.test.js --testTimeout=90000",
    "test:smoke": "cross-env SUITE=smoke jest tests/scenarios.test.js --testTimeout=90000",
    "test:sanity": "cross-env SUITE=sanity jest tests/scenarios.test.js --testTimeout=90000",
    "test:regression": "cross-env SUITE=regression jest tests/scenarios.test.js --testTimeout=90000",
    "test:critical": "cross-env SUITE=critical jest tests/scenarios.test.js --testTimeout=90000",
    "test:dom": "cross-env SECTOR_TYPE=DOM jest tests/scenarios.test.js --testTimeout=90000",
    "test:int": "cross-env SECTOR_TYPE=INT jest tests/scenarios.test.js --testTimeout=90000",
    "test:oneway": "cross-env TRIP_TYPE=OW jest tests/scenarios.test.js --testTimeout=90000",
    "test:roundtrip": "cross-env TRIP_TYPE=RT jest tests/scenarios.test.js --testTimeout=90000",
    "run:smoke": "node cli/run.js --suite smoke",
    "run:smoke:live": "cross-env API_ENV=live node cli/run.js --suite smoke",
    "run:sanity": "node cli/run.js --suite sanity",
    "run:regression": "node cli/run.js --suite regression",
    "run:critical": "node cli/run.js --suite critical",
    "run:failed": "node cli/run.js --rerun-failed",
    "test:allure": "jest --reporters=default --reporters=allure-jest",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "ui": "node server/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "api",
    "automation",
    "b2c",
    "jest",
    "axios",
    "allure",
    "ajv"
  ],
  "author": "Deepthy G",
  "license": "ISC",
  "dependencies": {
    "ajv": "^8.12.0",
    "ajv-formats": "^2.1.1",
    "axios": "^1.6.2",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "lodash": "^4.17.21",
    "minimist": "^1.2.8",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "allure-jest": "^2.15.1",
    "cross-env": "^7.0.3",
    "jest": "^29.7.0"
  }
}
